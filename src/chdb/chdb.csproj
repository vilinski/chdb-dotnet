<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <InternalsVisibleTo>tests</InternalsVisibleTo>
    <TargetFramework>netstandard2.1</TargetFramework>
    <RuntimeIdentifier>$(RID)</RuntimeIdentifier>
    <!-- <RuntimeIdentifiers>osx-x64;osx-arm64;linux-x64;linux-arm64</RuntimeIdentifiers> -->
    <!-- <PackageId Condition="$(IsLinuxX64) == true" >chdb-linux-x64</PackageId>
    <PackageId Condition="$(IsLinuxArm64) == true" >chdb-linux-arm64</PackageId>
    <PackageId Condition="$(IsOsxX64) == true" >chdb-osx-x64</PackageId>
    <PackageId Condition="$(IsOsxArm64) == true" >chdb-osx-arm64</PackageId> -->
    <PackageId>chdb-$(RID)</PackageId>
    <!-- <PackageId>chdb</PackageId> -->
    <Title>chdb</Title>
    <Description>chdb native bindings for dotnet core</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- <Content Include="libchdb.so" Pack="true" PackagePath="runtimes/$(RID)/native/" CopyToOutputDirectory="PreserveNewest" /> -->
    <None Condition="$(RID) == 'osx-arm64'"   Include="../../lib/macos-arm64/libchdb.so"   Pack="true" PackagePath="runtimes/$(RID)/native/" CopyToOutputDirectory="PreserveNewest" />
    <None Condition="$(RID) == 'linux-x64'"   Include="../../lib/linux-x86_64/libchdb.so"  Pack="true" PackagePath="runtimes/$(RID)/native/"   CopyToOutputDirectory="PreserveNewest" />
    <None Condition="$(RID) == 'osx-x64'"     Include="../../lib/macos-x86_64/libchdb.so"  Pack="true" PackagePath="runtimes/$(RID)/native/"   CopyToOutputDirectory="PreserveNewest" />
    <None Condition="$(RID) == 'linux-arm64'" Include="../../lib/linux-aarch64/libchdb.so" Pack="true" PackagePath="runtimes/$(RID)/native/" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
